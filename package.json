{
  "name": "auth.outboundendurance.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "sync:env:preview": "bun --env-file=.env.preview run scripts/vercel-env-upload.ts --environment preview",
    "sync:env:prod": "bun --env-file=.env.production run scripts/vercel-env-upload.ts --environment production",
    "provision:preview": "bun run sync:env:preview && bun --env-file=.env.preview run db:migrate && bun --env-file=.env.preview run db:seed && bun --env-file=.env.preview run stripe:catalog:sync && bun --env-file=.env.preview run stripe:portal:configure",
    "lint": "eslint",
    "test": "bun test",
    "stripe:subscriptions:reconcile": "bun run scripts/stripe-subscriptions-reconcile.ts",
    "stripe:catalog:sync": "bun run scripts/stripe-catalog-sync.ts",
    "stripe:portal:configure": "bun run scripts/stripe-billing-portal-config.ts",
    "db:seed": "bun run scripts/db-seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@react-email/components": "^1.0.12",
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.3.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "@vercel/sdk": "^1.28.67",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.38.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
